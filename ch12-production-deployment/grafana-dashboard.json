{
  "panels": [
    {
      "title": "Time to First Token (P95)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(time_to_first_token_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "title": "KV Cache Utilization",
      "type": "gauge",
      "targets": [
        {
          "expr": "kv_cache_utilization"
        }
      ],
      "options": {
        "thresholds": [
          {"value": 0.0, "color": "green"},
          {"value": 0.7, "color": "yellow"},
          {"value": 0.9, "color": "red"}
        ]
      }
    }
  ]
}
